# Test for solenoid

# Created by: Daniel Fu
# Updated: March 25, 2025

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

######################### DEFINE PHYSICS MODEL
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=120
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param -unset maxStep=0.01

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

######################### DEFINE INPUT BEAM

param -unset nparticles=50000
param -unset beamfile=solenoid_particles_before.txt
param -unset outfile=solenoid_particles_after.txt
beam ascii filename=$beamfile nEvents=$nparticles beamZ=0

######################### DEFINE SOLENOIDS

param -unset s_length=25
param -unset f_length=100
param -unset s_radius=50
param -unset s_thickness=50
param -unset s_current=848.353
param -unset start_offset=200
param -unset end_point=2*($start_offset+$f_length)

coil S1_coil innerRadius=$s_radius outerRadius=$s_radius+$s_thickness length=$s_length
solenoid S1 coilName=S1_coil current=$s_current kill=1
# virtualdetector VD radius=$s_radius+$s_thickness length=0.2 color=1,1,1 format=asciiExtended coordinates=centerline filename=$outfile-f.txt kill=1

##########################################################################################################
############################################  PLACE ELEMENTS  ############################################
##########################################################################################################

place S1 z=$start_offset front=1
place S1 z=$start_offset+2*$f_length front=1
zntuple zloop=0:$end_point:$end_point/40
ntuple TestNTuple detectors="Z*" union=1 file=$outfile format=ascii